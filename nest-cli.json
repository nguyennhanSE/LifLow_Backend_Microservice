      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "community-service": {
      "type": "application",
      "root": "apps/community-service",
      "entryFile": "main",
      "sourceRoot": "apps/community-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/community-service/tsconfig.app.json"
