generator client {
  provider     = "prisma-client"
  output       = "../generated/chat-service"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  PENDING
  COMPLETED
  FAILED
}

model RequestLog {
  id       String @id @default(uuid())
  sequence Int    @unique @default(autoincrement())

  // Trace / message context
  traceId         String?        @map("trace_id")
  requestId       String?        @unique @map("request_id")
  parentRequestId String?        @map("parent_request_id")
  correlationId   String?        @map("correlation_id")
  causationId     String?        @map("causation_id")
  requestPattern  String?        @map("request_pattern")
  requestStatus   RequestStatus? @default(PENDING) @map("request_status")

  // Service / source context
  serviceName     String? @map("service_name")
  serviceIp       String? @map("service_ip")
  serviceMetadata Json?   @map("service_metadata")

  // Actor
  userId      String? @map("user_id")
  anonymousId String? @map("anonymous_id")
  sessionId   String? @map("session_id")
  actorType   String? @map("actor_type") // user, admin, system, service

  // Entity
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  lokiPushedAt   DateTime? @map("loki_pushed_at")
  lokiPushError  String?   @map("loki_push_error")
  lokiRetryCount Int       @default(0) @map("loki_retry_count")

  @@index([userId, occurredAt])
  @@index([traceId, occurredAt])
  @@index([correlationId, occurredAt])
  @@map("request_logs")
}

model Room {
  id            String    @id @default(uuid())
  user1Id       String?    @map("user_1_id")
  user2Id       String?   @map("user_2_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([lastMessageAt])
  @@map("rooms")
}

model Message {
  id        String   @id @default(uuid())
  roomId    String   @unique @map("room_id")
  senderId  String?  @map("sender_id")
  content   String   @map("content")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  room   Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([roomId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("messages")
}