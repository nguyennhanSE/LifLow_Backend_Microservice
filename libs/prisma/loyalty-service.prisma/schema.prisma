generator client {
  provider     = "prisma-client"
  output       = "../generated/loyalty-service"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Membership {
  id             String           @id @default(uuid())
  name           String?          @unique
  nickName       String?          @map("nick_name")
  basePeriod     Int?             @map("base_period")
  description    String?
  minPrice       Int?             @map("min_price")
  userMembership UserMembership[]
  createdAt      DateTime?        @default(now()) @map("created_at")
  updatedAt      DateTime?        @updatedAt @map("updated_at")

  @@index([name])
  @@index([minPrice])
  @@map("memberships")
}

model UserMembership {
  id String @id @default(uuid())

  userId       String @unique @map("user_id")
  membershipId String @map("membership_id")

  membershipName        String @map("membership_name")
  membershipDescription String @map("membership_description")
  status                String @default("normal")

  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  updatedByAdmin Boolean  @default(false) @map("updated_by_admin")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([membershipId])
  @@index([userId])
  @@index([userId, membershipId])
  @@map("user_memberships")
}

enum RequestStatus {
  PENDING
  COMPLETED
  FAILED
}

model RequestLog {
  id       String @id @default(uuid())
  sequence Int    @unique @default(autoincrement())

  // Trace / message context
  traceId         String?        @map("trace_id")
  requestId       String?        @unique @map("request_id")
  parentRequestId String?        @map("parent_request_id")
  correlationId   String?        @map("correlation_id")
  causationId     String?        @map("causation_id")
  requestPattern  String?        @map("request_pattern")
  requestStatus   RequestStatus? @default(PENDING) @map("request_status")

  // Service / source context
  serviceName     String? @map("service_name")
  serviceIp       String? @map("service_ip")
  serviceMetadata Json?   @map("service_metadata")

  // Actor
  userId      String? @map("user_id")
  anonymousId String? @map("anonymous_id")
  sessionId   String? @map("session_id")
  actorType   String? @map("actor_type") // user, admin, system, service

  // Entity
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  lokiPushedAt   DateTime? @map("loki_pushed_at")
  lokiPushError  String?   @map("loki_push_error")
  lokiRetryCount Int       @default(0) @map("loki_retry_count")

  @@index([userId, occurredAt])
  @@index([traceId, occurredAt])
  @@index([correlationId, occurredAt])
  @@map("request_logs")
}
