{
  "name": "liflow-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/liflow-be/main",
    "start:api-gateway": "nest start api-gateway",
    "start:audit": "nest start audit-service",
    "start:cart": "nest start cart-service",
    "start:catalog": "nest start catalog-service",
    "start:chat": "nest start chat-service",
    "start:community": "nest start community-service",
    "start:identity": "nest start identity-service",
    "start:liflow": "nest start liflow-be",
    "start:loyalty": "nest start loyalty-service",
    "start:notification": "nest start notification-service",
    "start:order": "nest start order-service",
    "start:payment": "nest start payment-service",
    "start:promotion": "nest start promotion-service",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/liflow-be/test/jest-e2e.json",
    "prisma:api-gateway:generate": "DATABASE_URL=$API_GATEWAY_DATABASE_URL PRISMA_SERVICE=api-gateway prisma generate",
    "prisma:api-gateway:migrate": "DATABASE_URL=$API_GATEWAY_DATABASE_URL PRISMA_SERVICE=api-gateway prisma migrate dev",
    "prisma:api-gateway:migrate:deploy": "DATABASE_URL=$API_GATEWAY_DATABASE_URL PRISMA_SERVICE=api-gateway prisma migrate deploy",
    "prisma:api-gateway:studio": "DATABASE_URL=$API_GATEWAY_DATABASE_URL PRISMA_SERVICE=api-gateway prisma studio",
    "prisma:identity:generate": "PRISMA_SERVICE=identity-service prisma generate",
    "prisma:identity:migrate": "PRISMA_SERVICE=identity-service prisma migrate dev",
    "prisma:identity:migrate:deploy": "PRISMA_SERVICE=identity-service prisma migrate deploy",
    "prisma:identity:studio": "PRISMA_SERVICE=identity-service prisma studio",
    "prisma:identity:reset": "PRISMA_SERVICE=identity-service prisma migrate reset",
    "prisma:identity:seed": "PRISMA_SERVICE=identity-service ts-node -r tsconfig-paths/register libs/prisma/identity-service.prisma/seed.ts",
    "prisma:loyalty:generate": "PRISMA_SERVICE=loyalty-service prisma generate",
    "prisma:loyalty:migrate": "PRISMA_SERVICE=loyalty-service prisma migrate dev",
    "prisma:loyalty:migrate:deploy": "PRISMA_SERVICE=loyalty-service prisma migrate deploy",
    "prisma:loyalty:studio": "PRISMA_SERVICE=loyalty-service prisma studio",
    "prisma:loyalty:reset": "PRISMA_SERVICE=loyalty-service prisma migrate reset",
    "prisma:loyalty:seed": "PRISMA_SERVICE=loyalty-service ts-node -r tsconfig-paths/register libs/prisma/loyalty-service.prisma/seed.ts",
    "migrate:deploy": "npm run prisma:identity:migrate:deploy",
    "build:identity": "npm run prisma:identity:generate && nest build identity-service",
    "build:migrate:identity": "npm run prisma:identity:migrate:deploy && npm run build:identity",
    "build:migrate": "npm run build:migrate:identity"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.29",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1"
    }
  }
}
